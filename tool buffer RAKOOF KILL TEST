local autoKillActive = false
local cachedRemote = nil
local cachedTargets = {}

-- Safe background cacher (no stuttering)
task.spawn(function()
    while true do
        if autoKillActive then
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not tool then
                for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if item:IsA("Tool") then tool = item break end
                end
            end
            
            if tool then
                cachedRemote = tool:FindFirstChild("InflictTarget", true) or ReplicatedStorage:FindFirstChild("InflictTarget", true)
            end

            local newTargets = {}
            local function scan(node)
                for _, obj in ipairs(node:GetChildren()) do
                    if obj:IsA("Model") and obj ~= char then
                        local hum = obj:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                            local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
                            if part then
                                table.insert(newTargets, {humanoid = hum, rootPart = part})
                            end
                        end
                    elseif obj:IsA("Folder") then
                        scan(obj)
                    end
                end
            end
            
            if char then scan(Workspace) end
            cachedTargets = newTargets
            task.wait(0.25)
        else
            cachedTargets = {}
            cachedRemote = nil
            task.wait(0.5)
        end
    end
end)

-- Exactly 100 packets per second (0.01s delay) with zero lag
task.spawn(function()
    while true do
        if autoKillActive and cachedRemote and #cachedTargets > 0 then
            for _, target in ipairs(cachedTargets) do
                pcall(function()
