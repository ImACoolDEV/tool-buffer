-- High-speed optimized trigger function
local function triggerRemoteKill()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then
        for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") then
                tool = item
                break
            end
        end
    end

    if not tool then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "❌ Hold or have a gun in your inventory first!"
        return false
    end

    local inflictRemote = tool:FindFirstChild("InflictTarget", true) 
        or ReplicatedStorage:FindFirstChild("InflictTarget", true)

    if not inflictRemote then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "❌ 'InflictTarget' remote not found!"
        return false
    end

    local hitCount = 0
    
    -- Fast recursive container scan that avoids heavy part iterations
    local function scanContainer(container)
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Model") and obj ~= char then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                    local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        pcall(function()
                            inflictRemote:FireServer(hum, part)
                            hitCount += 1
                        end)
                    end
                end
            elseif obj:IsA("Folder") then
                scanContainer(obj)
            end
        end
    end

    scanContainer(Workspace)

    if hitCount > 0 then
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        StatusLabel.Text = string.format("✅ High-speed remote packets sent to %d target(s)!", hitCount)
        return true
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
        StatusLabel.Text = "⚠️ Gun found, but no active targets nearby."
        return false
    end
end

