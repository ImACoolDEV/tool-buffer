-- Fast Rake Finder (cached/targeted)
local function findRakeModel()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and (obj.Name == "THE_RAKE" or obj.Name:lower():find("rake") or obj.Name:lower():find("rakoof")) then
            local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildWhichIsA("BasePart")
            if part then return obj, part end
        end
    end
    return nil, nil
end

local shieldEnabled = false
ShieldToggleBtn.Activated:Connect(function()
    shieldEnabled = not shieldEnabled
    ShieldToggleBtn.Text = shieldEnabled and "🛡️ OPTIMIZED SHIELD: ON" or "🛡️ OPTIMIZED SHIELD: OFF"
    ShieldToggleBtn.BackgroundColor3 = shieldEnabled and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(35, 35, 45)
    ShieldToggleBtn.TextColor3 = shieldEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
end)

-- Lightweight background task running every 0.1 seconds instead of every frame to eliminate lag
task.spawn(function()
    while true do
        if shieldEnabled then
            pcall(function()
                local rakeModel, rakePart = findRakeModel()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if rakeModel and rakePart and hrp then
                    local distance = (hrp.Position - rakePart.Position).Magnitude
                    if distance < 30 then
                        rakePart.CFrame = hrp.CFrame * CFrame.new(0, 0, -35)
                    end
                end
            end)
            task.wait(0.1)
        else
            task.wait(0.5)
        end
    end
end)

BuffButton.Activated:Connect(function()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    
    if not tool then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "❌ Hold a tool in your hand first!"
        return
    end

    local mainScript = tool:FindFirstChild("Main", true)
    if not mainScript then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "❌ No 'Main' script found in tool!"
        return
    end

    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("Animation") or obj:IsA("AnimationTrack") or obj.Name:lower():find("anim") or obj.Name:lower():find("flop") or obj.Name:lower():find("ragdoll") then
            pcall(function() obj:Destroy() end)
        end
    end

    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if handle then
        if not tool:FindFirstChild("TrueRakeKillerTag") then
            local tag = Instance.new("BoolValue", tool)
            tag.Name = "TrueRakeKillerTag"

            handle.Touched:Connect(function(hit)
                if not hit or not hit.Parent then return end
                local hitModel = hit:FindFirstAncestorOfClass("Model")
                
                if hitModel and (hitModel.Name == "THE_RAKE" or hitModel.Name:lower():find("rake") or hitModel.Name:lower():find("rakoof")) and not Players:GetPlayerFromCharacter(hitModel) then
                    local hum = hitModel:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function()
                            hum.Health = 0
                            hum:ChangeState(Enum.HumanoidStateType.Dead)
                            for _, remote in ipairs(tool:GetDescendants()) do
                                if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
                                    remote:FireServer(hum, 999999999999)
                                    remote:FireServer(hitModel, 999999999999)
                                end
                            end
                            hitModel:BreakJoints()
                        end)
                    end
                end
            end)
        end
    end

    StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
    StatusLabel.Text = "✅ Ready! Shield optimized to run lag-free."
end)
