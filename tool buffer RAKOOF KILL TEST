local function superchargeTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    
    -- 1. Modify Configuration folder values (Damage, HitCD, Cooldown)
    local config = tool:FindFirstChild("Configuration")
    if config then
        for _, obj in ipairs(config:GetChildren()) do
            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                local name = obj.Name:lower()
                if name:find("damage") then
                    obj.Value = 999999999
                elseif name:find("cd") or name:find("cooldown") then
                    obj.Value = 0
                end
            end
        end
    end

    -- 2. Modify Settings Module if present (bypassing strict table checks)
    local settingModule = tool:FindFirstChild("Setting")
    if settingModule then
        local success, settingsTable = pcall(function()
            return require(settingModule)
        end)
        if success and type(settingsTable) == "table" then
            pcall(function()
                settingsTable.BaseDamage = 999999
                settingsTable.FireRate = 0.001
                settingsTable.AmmoPerClip = 99999
                settingsTable.MaxClip = 99999
                settingsTable.Spread = 0
                settingsTable.Auto = true
                settingsTable.Piercing = 10
            end)
        end
    end

    -- 3. Modify any other NumberValues or IntValues across all descendants
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            local name = obj.Name:lower()
            if name:find("damage") then
                obj.Value = 999999999
            elseif name:find("ammo") then
                obj.Value = 99999
            elseif name:find("cd") or name:find("cooldown") then
                obj.Value = 0
            end
        end
    end
end

local function scanAndBuffAll()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    local count = 0
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                superchargeTool(item)
                count += 1
            end
        end
    end
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                superchargeTool(item)
                count += 1
            end
        end
    end
    return count
end

